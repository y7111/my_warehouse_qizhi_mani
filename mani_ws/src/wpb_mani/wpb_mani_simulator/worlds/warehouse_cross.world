<?xml version="1.0" ?>
<!--
  warehouse_cross.world  —  20×16 十字形仓库地图（居中版）
  坐标系：x = col×1.0 - 10,  y = 8 - row×1.0,  每格 1.0m
  地图范围：x∈[-10,10], y∈[-8,8]（Gazebo 网格居中）

  关键坐标（grid → Gazebo）：
    货架 0: (1,8)  → (-1.5,  6.5)    货架 1: (1,11) → ( 1.5,  6.5)
    货架 2: (6,1)  → (-8.5,  1.5)    货架 3: (6,4)  → (-5.5,  1.5)
    货架 4: (8,1)  → (-8.5, -0.5)    货架 5: (8,4)  → (-5.5, -0.5)
    货架 6: (6,15) → ( 5.5,  1.5)    货架 7: (6,18) → ( 8.5,  1.5)
    货架 8: (8,15) → ( 5.5, -0.5)    货架 9: (8,18) → ( 8.5, -0.5)
    投递区 A: (13,7)  → (-2.5, -5.5)  [绿]
    投递区 B: (13,9)  → (-0.5, -5.5)  [黄]
    投递区 C: (13,11) → ( 1.5, -5.5)  [蓝]
    机器人起点：
      robot_0: (-2.0, -7.0)
      robot_1: (-1.0, -7.0)
      robot_2: ( 1.0, -7.0)
      robot_3: ( 2.0, -7.0)
-->
<sdf version="1.6">
  <world name="warehouse_cross">

    <!-- ==================== 光照 ==================== -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.88 0.88 0.88 1</ambient>
            <diffuse>0.88 0.88 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 物理参数 ==================== -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ==================== 外围封闭边界 ==================== -->
    <!-- 北侧通道顶部封边（y=8，x=-3~3） -->
    <model name="boundary_north">
      <static>true</static>
      <pose>0.0 8.025 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.05 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 南侧通道底部封边（y=-8，x=-3~3） -->
    <model name="boundary_south">
      <static>true</static>
      <pose>0.0 -8.025 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.05 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 西侧横臂封边（x=-10，y=-2.5~2.5） -->
    <model name="boundary_west">
      <static>true</static>
      <pose>-10.025 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.05 5.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.05 5.0 1.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 东侧横臂封边（x=10，y=-2.5~2.5） -->
    <model name="boundary_east">
      <static>true</static>
      <pose>10.025 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.05 5.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.05 5.0 1.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 主体墙块 ==================== -->

    <!-- NW 墙块：x=[-10,-3], y=[3,8] -->
    <model name="wall_nw">
      <static>true</static>
      <pose>-6.5 5.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 5.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7.0 5.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NE 墙块：x=[3,10], y=[3,8] -->
    <model name="wall_ne">
      <static>true</static>
      <pose>6.5 5.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 5.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7.0 5.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 北瓶颈隔墙：x=[-1,1], y=[3,4] -->
    <model name="wall_n_btl">
      <static>true</static>
      <pose>0.0 4.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 1.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 1.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SW 墙块：x=[-10,-3], y=[-8,-2] -->
    <model name="wall_sw">
      <static>true</static>
      <pose>-6.5 -5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 6.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7.0 6.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SE 墙块：x=[3,10], y=[-8,-2] -->
    <model name="wall_se">
      <static>true</static>
      <pose>6.5 -5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 6.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7.0 6.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 南瓶颈隔墙：x=[-1,1], y=[-4,-3] -->
    <model name="wall_s_btl">
      <static>true</static>
      <pose>0.0 -3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 1.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 1.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 西走廊隔墙：x=[-8,-5], y=[0,1] -->
    <model name="wall_corridor_w">
      <static>true</static>
      <pose>-6.5 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 1.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.0 1.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 东走廊隔墙：x=[5,8], y=[0,1] -->
    <model name="wall_corridor_e">
      <static>true</static>
      <pose>6.5 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 1.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.0 1.0 1.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 货架（10个）==================== -->

    <!-- shelf_0: (-1.5, 6.5) -->
    <model name="shelf_0">
      <static>true</static>
      <pose>-1.5 6.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_1: (1.5, 6.5) -->
    <model name="shelf_1">
      <static>true</static>
      <pose>1.5 6.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_2: (-8.5, 1.5) -->
    <model name="shelf_2">
      <static>true</static>
      <pose>-8.5 1.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_3: (-5.5, 1.5) -->
    <model name="shelf_3">
      <static>true</static>
      <pose>-5.5 1.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_4: (-8.5, -0.5) -->
    <model name="shelf_4">
      <static>true</static>
      <pose>-8.5 -0.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_5: (-5.5, -0.5) -->
    <model name="shelf_5">
      <static>true</static>
      <pose>-5.5 -0.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_6: (5.5, 1.5) -->
    <model name="shelf_6">
      <static>true</static>
      <pose>5.5 1.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_7: (8.5, 1.5) -->
    <model name="shelf_7">
      <static>true</static>
      <pose>8.5 1.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_8: (5.5, -0.5) -->
    <model name="shelf_8">
      <static>true</static>
      <pose>5.5 -0.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_9: (8.5, -0.5) -->
    <model name="shelf_9">
      <static>true</static>
      <pose>8.5 -0.5 0.11 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.22</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.22</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 投递区（纯视觉，无碰撞）==================== -->

    <!-- delivery_A: (-2.5, -5.5)，绿色 -->
    <model name="delivery_A">
      <static>true</static>
      <pose>-2.5 -5.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.002</size></box></geometry>
          <material>
            <ambient>0.15 0.80 0.15 1</ambient>
            <diffuse>0.15 0.80 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- delivery_B: (-0.5, -5.5)，黄色 -->
    <model name="delivery_B">
      <static>true</static>
      <pose>-0.5 -5.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.002</size></box></geometry>
          <material>
            <ambient>0.90 0.85 0.10 1</ambient>
            <diffuse>0.90 0.85 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- delivery_C: (1.5, -5.5)，蓝色 -->
    <model name="delivery_C">
      <static>true</static>
      <pose>1.5 -5.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.002</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.85 1</ambient>
            <diffuse>0.15 0.15 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
