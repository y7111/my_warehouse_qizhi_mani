    <model name="robot_0">
      <pose>-1.5 -7.0 0 0 0 1.5707963</pose>
      <static>false</static>
    <link name='base_footprint'>
      <inertial>
        <pose>0.00107 0 0.001493 0 -0 0</pose>
        <mass>20.1</mass>
        <inertia>
          <ixx>0.509955</ixx>
          <ixy>-6.46235e-27</ixy>
          <ixz>-0.00641791</ixz>
          <iyy>0.514555</iyy>
          <iyz>0</iyz>
          <izz>0.5056</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.14 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.57 0.45 0.28</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__laser_collision_1'>
        <pose>0.215 0 0.3 0 -0 3.14159</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.04</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0 0 0.14 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.57 0.45 0.28</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Blue</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__laser_visual_1'>
        <pose>0.215 0 0.3 0 -0 3.14159</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.04</radius>
          </cylinder>
        </geometry>
      </visual>
      <sensor name='rplidar_sensor' type='ray'>
        <visualize>0</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10</max>
          </range>
        </ray>
        <plugin name='rplidar_ros_controller' filename='libgazebo_ros_laser.so'>
          <robotNamespace>robot_0</robotNamespace>
          <topicName>scan_raw</topicName>
          <frameName>laser</frameName>
        </plugin>
        <pose>0.215 0 0.32 0 -0 3.14159</pose>
      </sensor>
    </link>
    <plugin name='planar_controller' filename='libgazebo_ros_planar_move.so'>
      <robotNamespace>robot_0</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <broadcastTF>0</broadcastTF>
    </plugin>
    <frame name='laser_joint' attached_to='base_link'>
      <pose>0.215 0 0.3 0 -0 3.14159</pose>
    </frame>
    <frame name='laser' attached_to='laser_joint'/>
    <frame name='base_joint' attached_to='base_footprint'>
      <pose>0 0 0 0 -0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_joint'/>
      </model>

