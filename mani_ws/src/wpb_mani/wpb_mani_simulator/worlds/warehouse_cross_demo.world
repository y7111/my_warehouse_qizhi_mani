<?xml version="1.0" ?>
<!--
  warehouse_cross.world  —  20×16 十字形仓库地图（居中版）
  坐标系：x = col×1.0 - 10,  y = 8 - row×1.0,  每格 1.0m
  地图范围：x∈[-10,10], y∈[-8,8]（Gazebo 网格居中）

  关键坐标（grid → Gazebo）：
    货架 0: (1,8)  → (-1.5,  6.5)    货架 1: (1,11) → ( 1.5,  6.5)
    货架 2: (6,1)  → (-8.5,  1.5)    货架 3: (6,4)  → (-5.5,  1.5)
    货架 4: (8,1)  → (-8.5, -0.5)    货架 5: (8,4)  → (-5.5, -0.5)
    货架 6: (6,15) → ( 5.5,  1.5)    货架 7: (6,18) → ( 8.5,  1.5)
    货架 8: (8,15) → ( 5.5, -0.5)    货架 9: (8,18) → ( 8.5, -0.5)
    投递区 A: (13,7)  → (-2.5, -5.5)  [绿]
    投递区 B: (13,9)  → (-0.5, -5.5)  [黄]
    投递区 C: (13,11) → ( 1.5, -5.5)  [蓝]
    机器人起点：
      robot_0: (-2.0, -7.0)
      robot_1: (-1.0, -7.0)
      robot_2: ( 1.0, -7.0)
      robot_3: ( 2.0, -7.0)
-->
<sdf version="1.6">
  <world name="warehouse_cross">

    <!-- ==================== 光照 ==================== -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.88 0.88 0.88 1</ambient>
            <diffuse>0.88 0.88 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 物理参数 ==================== -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ==================== 外围封闭边界 ==================== -->
    <!-- 北侧通道顶部封边（y=8，x=-3~3） -->
    <model name="boundary_north">
      <static>true</static>
      <pose>0.0 8.025 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.05 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 南侧通道底部封边（y=-8，x=-3~3） -->
    <model name="boundary_south">
      <static>true</static>
      <pose>0.0 -8.025 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.0 0.05 1.5</size></box></geometry></collision>
