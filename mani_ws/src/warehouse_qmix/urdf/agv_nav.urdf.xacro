<?xml version="1.0"?>
<robot name="agv_nav" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_ns" default=""/>

  <!-- base_footprint -->
  <link name="base_footprint"/>

  <!-- base_link: 简单长方体（0.57×0.45×0.28m），蓝色 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.57 0.45 0.28"/></geometry>
      <material name="agv_blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.57 0.45 0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- laser link: 小黑圆柱 -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="agv_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.215 0 0.30" rpy="0 0 3.1415926"/>
  </joint>

  <!-- planar move 插件 -->
  <gazebo>
    <plugin name="planar_controller" filename="libgazebo_ros_planar_move.so">
      <robotNamespace>$(arg robot_ns)</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <broadcastTF>false</broadcastTF>
    </plugin>
  </gazebo>

  <!-- 激光雷达传感器 -->
  <gazebo reference="laser">
    <sensor type="ray" name="rplidar_sensor">
      <pose>0 0 0.02 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
        </range>
      </ray>
      <plugin name="rplidar_ros_controller" filename="libgazebo_ros_laser.so">
        <robotNamespace>$(arg robot_ns)</robotNamespace>
        <topicName>scan_raw</topicName>
        <frameName>laser</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
