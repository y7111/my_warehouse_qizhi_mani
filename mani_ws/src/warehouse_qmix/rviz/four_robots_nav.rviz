Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Robot01
        - /Robot11
        - /Robot21
        - /Robot31
        - /Shelves1
      Splitter Ratio: 0.5
    Tree Height: 900
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Value: true

    # ── robot_0  蓝色 ──────────────────────────────────────────────
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/LaserScan
          Color: 0; 0; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Scan0
          Queue Size: 10
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic: /robot_0/scan
          Unreliable: false
          Value: true

        - Alpha: 1
          Class: rviz/RobotModel
          Collision Enabled: false
          Enabled: true
          Name: Model0
          Robot Description: robot_0/robot_description
          TF Prefix: robot_0
          Update Interval: 0
          Value: true
          Visual Enabled: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 0; 255
          Enabled: true
          Line Style: Billboards
          Line Width: 0.05
          Name: Path0
          Topic: /robot_0/move_base/GlobalPlanner/plan
          Unreliable: false
          Value: true

        - Arrow Length: 0.3
          Class: rviz/PoseArray
          Color: 0; 0; 255
          Enabled: false
          Name: Particles0
          Topic: /robot_0/particlecloud
          Unreliable: false
          Value: false
      Enabled: true
      Name: Robot0

    # ── robot_1  红色 ──────────────────────────────────────────────
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/LaserScan
          Color: 255; 0; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Scan1
          Queue Size: 10
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic: /robot_1/scan
          Unreliable: false
          Value: true

        - Alpha: 1
          Class: rviz/RobotModel
          Collision Enabled: false
          Enabled: true
          Name: Model1
          Robot Description: robot_1/robot_description
          TF Prefix: robot_1
          Update Interval: 0
          Value: true
          Visual Enabled: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 0; 0
          Enabled: true
          Line Style: Billboards
          Line Width: 0.05
          Name: Path1
          Topic: /robot_1/move_base/GlobalPlanner/plan
          Unreliable: false
          Value: true

        - Arrow Length: 0.3
          Class: rviz/PoseArray
          Color: 255; 0; 0
          Enabled: false
          Name: Particles1
          Topic: /robot_1/particlecloud
          Unreliable: false
          Value: false
      Enabled: true
      Name: Robot1

    # ── robot_2  绿色 ──────────────────────────────────────────────
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/LaserScan
          Color: 0; 200; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Scan2
          Queue Size: 10
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic: /robot_2/scan
          Unreliable: false
          Value: true

        - Alpha: 1
          Class: rviz/RobotModel
          Collision Enabled: false
          Enabled: true
          Name: Model2
          Robot Description: robot_2/robot_description
          TF Prefix: robot_2
          Update Interval: 0
          Value: true
          Visual Enabled: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 200; 0
          Enabled: true
          Line Style: Billboards
          Line Width: 0.05
          Name: Path2
          Topic: /robot_2/move_base/GlobalPlanner/plan
          Unreliable: false
          Value: true

        - Arrow Length: 0.3
          Class: rviz/PoseArray
          Color: 0; 200; 0
          Enabled: false
          Name: Particles2
          Topic: /robot_2/particlecloud
          Unreliable: false
          Value: false
      Enabled: true
      Name: Robot2

    # ── robot_3  橙色 ──────────────────────────────────────────────
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/LaserScan
          Color: 255; 140; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Scan3
          Queue Size: 10
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic: /robot_3/scan
          Unreliable: false
          Value: true

        - Alpha: 1
          Class: rviz/RobotModel
          Collision Enabled: false
          Enabled: true
          Name: Model3
          Robot Description: robot_3/robot_description
          TF Prefix: robot_3
          Update Interval: 0
          Value: true
          Visual Enabled: true

        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 140; 0
          Enabled: true
          Line Style: Billboards
          Line Width: 0.05
          Name: Path3
          Topic: /robot_3/move_base/GlobalPlanner/plan
          Unreliable: false
          Value: true

        - Arrow Length: 0.3
          Class: rviz/PoseArray
          Color: 255; 140; 0
          Enabled: false
          Name: Particles3
          Topic: /robot_3/particlecloud
          Unreliable: false
          Value: false
      Enabled: true
      Name: Robot3

    # ── 货架标记 ───────────────────────────────────────────────────
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /warehouse/shelf_markers
      Name: Shelves
      Namespaces:
        {}
      Queue Size: 100
      Value: true

    # ── 货物状态（实时）────────────────────────────────────────────
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /warehouse/cargo_markers
      Name: Cargo
      Namespaces:
        {}
      Queue Size: 100
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 28.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5707
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 0
