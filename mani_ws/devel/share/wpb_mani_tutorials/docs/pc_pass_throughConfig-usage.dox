  <param name="x_min" type="double" value="0.5" />
  <param name="x_max" type="double" value="1.5" />
  <param name="y_min" type="double" value="-0.5" />
  <param name="y_max" type="double" value="0.5" />
  <param name="z_min" type="double" value="0.1" />
  <param name="z_max" type="double" value="0.5" />
</node>
\endverbatim

